<Project Sdk="Microsoft.NET.Sdk">

  <!--
    打包项目：生成 NuGet 包 CSMacro。使用方只需要引用这一个包。
      ref/netstandard2.0/CSMacro.Abstractions.dll(.xml)  写宏用的 API。只作编译期引用 → 不会成为程序的运行时依赖
      build/CSMacro.targets                              NuGet 自动导入：在编译前展开宏
      tools/net10.0/                                     预编译好的展开工具（CSMacro.Cli 及其依赖）
    打包：dotnet pack pack/CSMacro -c Release   → artifacts/packages/CSMacro.<版本>.nupkg
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>CSMacro</PackageId>
    <Version>$(CSMacroVersion)</Version>
    <Description>Compile-time macros for C#. Macros are ordinary C# methods and attributes that the IDE understands; the build runs them and compiles the expanded code. No IDE plugin, no runtime dependency.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- 这个项目自己没有代码，只负责组装包 -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- 只在编译期使用：dotnet add package 时自动加上 PrivateAssets="all" -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- NU5128/NU5131：包里故意只有 ref/（编译期引用）没有 lib/（运行时），这是预期的 -->
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5131</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CSMacroPackageFiles</TargetsForTfmSpecificContentInPackage>
    <_CSMacroCliPublishDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)cli-publish/</_CSMacroCliPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../build/CSMacro.targets" Pack="true" PackagePath="build/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Target Name="CSMacroPackageFiles">
    <!-- 展开工具：框架依赖发布（RollForward=Major，装了 .NET 10 及以上运行时即可） -->
    <RemoveDir Directories="$(_CSMacroCliPublishDir)" />
    <!-- RemoveProperties：不要把本项目的 TargetFramework 等全局属性传下去 -->
    <MSBuild Projects="../../src/CSMacro.Cli/CSMacro.Cli.csproj" Targets="Publish" RemoveProperties="TargetFramework;RuntimeIdentifier"
             Properties="Configuration=$(Configuration);PublishDir=$(_CSMacroCliPublishDir);SelfContained=false;UseAppHost=false;SatelliteResourceLanguages=en" />
    <MSBuild Projects="../../src/CSMacro.Abstractions/CSMacro.Abstractions.csproj" Targets="Build" RemoveProperties="TargetFramework;RuntimeIdentifier"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CSMacroAbstractions" />
    </MSBuild>

    <ItemGroup>
      <_CSMacroCliFiles Include="$(_CSMacroCliPublishDir)**/*" Exclude="$(_CSMacroCliPublishDir)**/*.pdb" />
      <TfmSpecificPackageFile Include="@(_CSMacroCliFiles)" PackagePath="tools/net10.0/%(RecursiveDir)" />
      <TfmSpecificPackageFile Include="@(_CSMacroAbstractions)" PackagePath="ref/netstandard2.0/" />
      <TfmSpecificPackageFile Include="@(_CSMacroAbstractions->'%(RootDir)%(Directory)%(Filename).xml')" PackagePath="ref/netstandard2.0/" />
    </ItemGroup>
  </Target>

</Project>
