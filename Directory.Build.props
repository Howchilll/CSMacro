<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Version of the published NuGet packages (HowMacro, HowMacro.Testing) -->
    <!-- The publish workflow overrides this with the version from the git tag (v0.1.2-preview -> 0.1.2-preview) -->
    <HowMacroVersion>0.1.2-preview</HowMacroVersion>

    <!-- Nothing is packable by default; only pack/HowMacro and src/HowMacro.Testing are packed -->
    <IsPackable>false</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <Authors>HowMacro contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>macro;metaprogramming;roslyn;msbuild;codegen</PackageTags>
    <PackageProjectUrl>https://github.com/Howchilll/CSMacro</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Howchilll/CSMacro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
