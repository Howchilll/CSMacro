<Project Sdk="Microsoft.NET.Sdk">

  <!-- 宏作者的测试项目示例：引用宏库 + CSMacro.Testing，用任意测试框架（这里是 xUnit）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../samples/Demo.Macros/Demo.Macros.csproj" />
    <ProjectReference Include="../../src/CSMacro.Testing/CSMacro.Testing.csproj" />
    <!-- CSMacro.Testing 对引擎的引用是 PrivateAssets（引擎打进 NuGet 包里，不单独发包），源码引用时要直接引用一下 -->
    <ProjectReference Include="../../src/CSMacro.Engine/CSMacro.Engine.csproj" />
  </ItemGroup>

</Project>
