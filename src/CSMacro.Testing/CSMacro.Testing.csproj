<Project Sdk="Microsoft.NET.Sdk">

  <!--
    给宏作者用的测试工具：在测试进程里直接展开一段源码，断言展开结果、诊断，或者编译运行后测行为。
    不依赖任何测试框架，断言失败抛 MacroTestException。
    发布为 NuGet 包 CSMacro.Testing：引擎和 API 程序集一起打进包里。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>CSMacro.Testing</PackageId>
    <Version>$(CSMacroVersion)</Version>
    <Description>Test helpers for CSMacro macro authors: expand source in a unit test, assert on output and diagnostics, or compile and run the expanded code. Works with any test framework.</Description>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CSMacroIncludeReferencedProjects</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引擎不单独发包：打进本包（PrivateAssets 避免生成对不存在的包的依赖） -->
    <ProjectReference Include="../CSMacro.Engine/CSMacro.Engine.csproj" PrivateAssets="all" />
    <!-- 引擎依赖的 Roslyn 作为本包的 NuGet 依赖 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <Target Name="CSMacroIncludeReferencedProjects" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))"
                            Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
