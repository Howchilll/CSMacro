<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host: invoked by MSBuild before compilation; loads macro assemblies and runs the macros. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HowMacro.Engine/HowMacro.Engine.csproj" />
  </ItemGroup>

</Project>
