<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only assembly macro authors reference. netstandard2.0: usable from regular .NET and Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>HowMacro</RootNamespace>
    <!-- Ship XML docs in the package so consumers see API docs in the IDE while writing macros -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
