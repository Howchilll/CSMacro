<Project>

  <!--
    CSMacro 的 MSBuild 接入。
    思路：截流编译器拿到的源码清单，而不是修改源文件。
      1. CoreCompile 之前，把 @(Compile) 和引用交给 csmacro。
      2. csmacro 把含宏的文件展开到 obj/…/csmacro/src/（首行 #line 指回原文件）。
      3. 把这些原文件从 @(Compile) 里换成展开后的副本，并加入引擎生成的辅助脚本（启动代码）。
       编译器只看到展开结果。
    可选属性：
      CSMacroStartupAttribute  启动辅助脚本入口上的特性（默认 ModuleInitializer）
      CSMacroVerify=false      不对宏生成的代码做编译检查
      CSMacroDump=true         另外把展开结果写到 dump 目录，用来排查问题（不影响真正的编译）
      CSMacroDumpDir=<目录>    dump 目录，默认是项目下的 csmacro-dump（相对项目目录），自动排除在编译之外
      CSMacroDumpFiles=<a b>   只写出这些文件（相对路径或文件名，支持 * 和 **）；设置后自动开启 dump
      CSMacroDumpMacros=<a b>  dump 时只展开这些宏，其余保持原样；设置后自动开启 dump
      CSMacroRuntimeCleanup=false  不做运行时清理（默认会把运行时用不到的宏程序集从引用和输出中移除）
    展开工具（CSMacro.Cli）由这里自动构建，使用方不需要引用它。
    IDE 的 design-time build 跳过这一步，所以 IDE 看到的是原文件：宏就是一个普通方法调用。
  -->

  <PropertyGroup>
    <CSMacroEnabled Condition="'$(CSMacroEnabled)' == ''">true</CSMacroEnabled>
    <CSMacroRuntimeCleanup Condition="'$(CSMacroRuntimeCleanup)' == ''">true</CSMacroRuntimeCleanup>
    <_CSMacroCliProject>$(MSBuildThisFileDirectory)../src/CSMacro.Cli/CSMacro.Cli.csproj</_CSMacroCliProject>
    <_CSMacroBuildCli Condition="'$(CSMacroCliPath)' == ''">true</_CSMacroBuildCli>
    <CSMacroCliPath Condition="'$(CSMacroCliPath)' == ''">$(MSBuildThisFileDirectory)../src/CSMacro.Cli/bin/$(Configuration)/net10.0/CSMacro.Cli.dll</CSMacroCliPath>
    <CSMacroDotnet Condition="'$(CSMacroDotnet)' == '' and '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</CSMacroDotnet>
    <CSMacroDotnet Condition="'$(CSMacroDotnet)' == ''">dotnet</CSMacroDotnet>

    <!-- dump：设置了文件/宏筛选也视为开启 -->
    <CSMacroDump Condition="'$(CSMacroDump)' == '' and ('$(CSMacroDumpFiles)' != '' or '$(CSMacroDumpMacros)' != '')">true</CSMacroDump>
    <CSMacroDumpDir Condition="'$(CSMacroDumpDir)' == ''">csmacro-dump</CSMacroDumpDir>
    <!-- dump 目录里是展开后的副本，绝不能再被当作源码编译（命令行构建和 IDE 都排除） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(CSMacroDumpDir)/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 自动构建展开工具（同一次构建里多个项目共用，MSBuild 只会构建一次） -->
  <Target Name="CSMacroBuildCli" Condition="'$(_CSMacroBuildCli)' == 'true'">
    <MSBuild Projects="$(_CSMacroCliProject)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CSMacroExpand"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences;CSMacroBuildCli"
          Condition="'$(CSMacroEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">

    <PropertyGroup>
      <_CSMacroDir>$(ProjectDir)$(IntermediateOutputPath)csmacro/</_CSMacroDir>
      <_CSMacroRsp>$(_CSMacroDir)args.rsp</_CSMacroRsp>
      <_CSMacroOriginalsFile>$(_CSMacroDir)originals.txt</_CSMacroOriginalsFile>
      <_CSMacroExpandedFile>$(_CSMacroDir)expanded.txt</_CSMacroExpandedFile>
      <_CSMacroRuntimeUnusedFile>$(_CSMacroDir)runtime-unused.txt</_CSMacroRuntimeUnusedFile>
    </PropertyGroup>

    <ItemGroup>
      <_CSMacroArg Include="--out:$(_CSMacroDir)src" />
      <_CSMacroArg Include="--originals:$(_CSMacroOriginalsFile)" />
      <_CSMacroArg Include="--expanded:$(_CSMacroExpandedFile)" />
      <_CSMacroArg Include="--runtime-unused:$(_CSMacroRuntimeUnusedFile)" />
      <_CSMacroArg Include="--langversion:$(LangVersion)" />
      <_CSMacroArg Include="--nullable:$(Nullable)" />
      <_CSMacroArg Include="--output-type:$(OutputType)" />
      <_CSMacroArg Include="-d:$([MSBuild]::Escape($(DefineConstants)))" />
      <_CSMacroArg Include="--startup-attribute:$(CSMacroStartupAttribute)" Condition="'$(CSMacroStartupAttribute)' != ''" />
      <_CSMacroArg Include="--no-verify" Condition="'$(CSMacroVerify)' == 'false'" />
      <_CSMacroArg Include="--dump:$(CSMacroDumpDir)" Condition="'$(CSMacroDump)' == 'true'" />
      <_CSMacroArg Include="--dump-files:$([MSBuild]::Escape($(CSMacroDumpFiles)))" Condition="'$(CSMacroDumpFiles)' != ''" />
      <_CSMacroArg Include="--dump-macros:$([MSBuild]::Escape($(CSMacroDumpMacros)))" Condition="'$(CSMacroDumpMacros)' != ''" />
      <_CSMacroArg Include="@(Compile->'-s:%(Identity)')" />
      <_CSMacroArg Include="@(ReferencePath->'-r:%(FullPath)')" />
    </ItemGroup>

    <MakeDir Directories="$(_CSMacroDir)" />
    <WriteLinesToFile File="$(_CSMacroRsp)" Lines="@(_CSMacroArg)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <Exec Command="&quot;$(CSMacroDotnet)&quot; &quot;$(CSMacroCliPath)&quot; &quot;@$(_CSMacroRsp)&quot;" />

    <ReadLinesFromFile File="$(_CSMacroOriginalsFile)">
      <Output TaskParameter="Lines" ItemName="_CSMacroOriginal" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_CSMacroExpandedFile)">
      <Output TaskParameter="Lines" ItemName="_CSMacroExpanded" />
    </ReadLinesFromFile>

    <ItemGroup>
      <Compile Remove="@(_CSMacroOriginal)" />
      <Compile Include="@(_CSMacroExpanded)" />
    </ItemGroup>

    <!--
      运行时清理：宏库只在编译期有用。展开后已经用不到的宏程序集（csmacro 用 GetUsedAssemblyReferences 判定）
      从编译引用、复制到输出的文件中移除，于是程序集元数据、deps.json、输出目录里都不再有它们。
    -->
    <ReadLinesFromFile File="$(_CSMacroRuntimeUnusedFile)" Condition="'$(CSMacroRuntimeCleanup)' == 'true'">
      <Output TaskParameter="Lines" ItemName="_CSMacroRuntimeUnused" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_CSMacroRuntimeUnusedNames>;@(_CSMacroRuntimeUnused->'%(Filename)');</_CSMacroRuntimeUnusedNames>
    </PropertyGroup>
    <ItemGroup Condition="'@(_CSMacroRuntimeUnused)' != ''">
      <_CSMacroDropReference Include="@(ReferencePath)" Condition="$(_CSMacroRuntimeUnusedNames.Contains(';%(Filename);'))" />
      <_CSMacroDropRefAssembly Include="@(ReferencePathWithRefAssemblies)" Condition="$(_CSMacroRuntimeUnusedNames.Contains(';%(Filename);'))" />
      <_CSMacroDropCopyLocal Include="@(ReferenceCopyLocalPaths)" Condition="$(_CSMacroRuntimeUnusedNames.Contains(';%(Filename);'))" />
      <ReferencePath Remove="@(_CSMacroDropReference)" />
      <ReferencePathWithRefAssemblies Remove="@(_CSMacroDropRefAssembly)" />
      <ReferenceCopyLocalPaths Remove="@(_CSMacroDropCopyLocal)" />
    </ItemGroup>
  </Target>

</Project>
