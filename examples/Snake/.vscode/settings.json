{
  // Hide build output and intermediate files so the IDE shows only source code.
  // howmacro-dump/ is intentionally visible: you need it when debugging macro expansion (it only exists after building with -p:HowMacroDump=true).
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.howmacro-dump": true,
    "**/*.sav": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/howmacro-dump": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },
  "dotnet.defaultSolution": "Snake.csproj"
}
