<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Uses a locally built HowMacro package.
      Run dotnet pack pack/HowMacro -c Release in the HowMacro repository root (DotNet/); the package goes to artifacts/packages/.
      If you use the published package from nuget.org instead, delete this line.
    -->
    <add key="howmacro-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
