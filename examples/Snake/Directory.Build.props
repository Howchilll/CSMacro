<Project>
  <!--
    This example is a standalone project: this file stops MSBuild from picking up the HowMacro repository's own Directory.Build.props,
    so it builds exactly like any external project.
  -->
  <PropertyGroup>
    <!-- Version of the HowMacro package to reference -->
    <HowMacroVersion>0.1.5-preview</HowMacroVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
