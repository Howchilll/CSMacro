<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- dotnet build -p:TraceState=true turns on the #region @TRACE_STATE state tracing (without it no tracing code is generated at all) -->
    <DefineConstants Condition="'$(TraceState)' == 'true'">$(DefineConstants);TRACE_STATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Using HowMacro: reference the package + say which folder holds the macros. Just these two lines. -->
    <PackageReference Include="HowMacro" Version="$(HowMacroVersion)" PrivateAssets="all" />
    <HowMacroDefinition Include="Macros/**/*.cs" />

    <None Update="snake.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
