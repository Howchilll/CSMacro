<Project>
  <!--
    这个案例是一个独立项目：这个文件让 MSBuild 不再往上找 CSMacro 仓库自己的 Directory.Build.props，
    所以它的构建设置和普通外部项目完全一样。
  -->
  <PropertyGroup>
    <!-- 引用的 CSMacro 包版本（宏库和游戏用同一个版本） -->
    <CSMacroVersion>0.1.0</CSMacroVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
