<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      CSMacro 还没有发布到 nuget.org，这里用本地生成的包。
      在 CSMacro 仓库根目录（DotNet/）运行 dotnet pack pack/CSMacro -c Release，包会生成在 artifacts/packages/。
      CSMacro 发布到 nuget.org 之后，删掉这一行即可。
    -->
    <add key="csmacro-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
