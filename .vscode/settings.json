{
  // Hide things developers don't need to look at: build output, caches, OS files.
  // howmacro-dump/ is intentionally visible: you need it when debugging expansions.
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/TestResults": true,
    "**/.howmacro-dump": true,
    "**/.DS_Store": true,
    "**/.git": true
  },
  // Skip these in search too, plus dump folders (expanded copies would duplicate search results)
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/TestResults": true,
    "**/howmacro-dump": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },
  "dotnet.defaultSolution": "HowMacro.slnx"
}
